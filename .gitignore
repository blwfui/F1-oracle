.env
.idea/
__pycache__/
*.pyc
*.pyo
.venv/
.streamlit/secrets.toml

# Local agent workspaces (work logs / temp files — never publish)
.workbuddy/
.reasonix/

# Data & cache
data/cache/
data/*.db
data/*.db-shm
data/*.db-wal
data/*.log

# Generated replay animations (self-contained HTML, ~200 KB each).
# Regenerate with:  python -m scripts.export_replay <year> <round>
outputs/

# Temp files
# 注意：`*.txt` 会连依赖清单一起吞掉 —— GitHub 上 CI 第一步就要
# `pip install -r requirements-dev.txt`，文件不在仓库里会直接失败。
*.txt
!requirements.txt
!requirements-dev.txt
!docs/*.txt
db_output.txt
